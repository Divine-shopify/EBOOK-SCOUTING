# --- Core -------------------------------------------------------------------
DATABASE_PATH=data/authorscout.db      # SQLite file (created + migrated automatically)
PORT=3000                              # dashboard port (binds 127.0.0.1 unless HOST is set)
USER_AGENT=AuthorScoutBot/0.1 (+research; respects robots.txt)
MAX_SPEND_USD=5                        # hard ceiling on paid API spend per run (also set in Research controls)

# --- AI analysis (optional) -------------------------------------------------
# Enables an extra LLM pass that classifies fetched page text. Without it, rule-based analysis is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Web search providers (optional; any one enables open-web discovery) ------
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
# Open Library needs no key. Google Books works keyless but shares a small quota:
GOOGLE_BOOKS_API_KEY=

# --- Email verification provider (optional) ---------------------------------
# none | zerobounce | neverbounce. Without a provider, emails top out at "domain_mx_checked".
EMAIL_VERIFIER=none
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=

# --- Browser rendering (optional) -------------------------------------------
# Used only when "useBrowser" is enabled in Research controls, for JS-only author sites.
BROWSER_EXECUTABLE=/opt/pw-browsers/chromium
